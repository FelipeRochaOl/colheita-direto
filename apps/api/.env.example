# ---------- App ----------
NODE_ENV=development
PORT=3000
WEB_APP_URL=http://localhost:5173
JWT_SECRET=troque-por-um-segredo-longo-de-desenvolvimento
PRIVACY_POLICY_VERSION=2026-11

# ---------- MongoDB (local: docker compose | produção: MongoDB Atlas) ----------
MONGODB_URI=mongodb://localhost:27017/colheita-direta

# ---------- AWS (local: LocalStack) ----------
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
# Credenciais fictícias do LocalStack (em produção a task ECS usa IAM role, sem chaves)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
HARVEST_PHOTOS_BUCKET=colheita-direta-harvest-photos
HARVEST_LOT_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/harvest-lot-events
NOTIFICATION_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/notification-events

# ---------- Serviço de visão ----------
VISION_SERVICE_URL=http://localhost:8000

# ---------- Claude (Amazon Bedrock) ----------
BEDROCK_REGION=us-east-1
CLAUDE_MODEL_ID=anthropic.claude-opus-5-5

# ---------- Asaas (vazio = gateway de pagamento simulado) ----------
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_PLATFORM_FEE_PERCENT=8

# ---------- WhatsApp Cloud API (vazio = mensagens só no log) ----------
WHATSAPP_GRAPH_API_URL=https://graph.facebook.com/v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ---------- SMS (vazio = mensagens só no log) ----------
SMS_ENABLED=false
