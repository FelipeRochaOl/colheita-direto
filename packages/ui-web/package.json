{
  "name": "@colheita/ui-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external react --external antd",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch --external react --external antd",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@colheita/contracts": "workspace:*",
    "@colheita/design-tokens": "workspace:*",
    "countup.js": "2.10.1"
  },
  "peerDependencies": {
    "antd": "^5.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@colheita/config": "workspace:*",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "antd": "^5.29.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3"
  }
}