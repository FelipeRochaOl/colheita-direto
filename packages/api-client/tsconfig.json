{
  "extends": "@colheita/config/tsconfig.react.json",
  "include": [
    "src"
  ],
  "compilerOptions": {
    "paths": {
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ]
    }
  }
}