{
  "name": "@colheita/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external react",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch --external react",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@colheita/contracts": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@colheita/config": "workspace:*",
    "@tanstack/react-query": "^5.107.1",
    "@types/react": "^18.3.12",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3"
  }
}