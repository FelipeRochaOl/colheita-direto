# Copie para infra/.env (ignorado pelo git). Carregado por pnpm infra:start / infra:stop.

# Chave de API da organização no MongoDB Atlas (permissão Organization Project Creator).
# Atlas → Organization Settings → Access Manager → Applications → API Keys → Create API Key
MONGODB_ATLAS_PUBLIC_KEY=
MONGODB_ATLAS_PRIVATE_KEY=

# Opcionais
# AWS_PROFILE=colheita-terraform
# AWS_REGION=sa-east-1
