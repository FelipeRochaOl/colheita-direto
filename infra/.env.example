# Copie para infra/.env (ignorado pelo git). Carregado por pnpm infra:start / infra:stop.

# Service Account da organização no MongoDB Atlas (permissão Organization Project Creator).
# Atlas → Organization Settings → Access Manager → Applications → Service Accounts → Create Service Account
MONGODB_ATLAS_CLIENT_ID=
MONGODB_ATLAS_CLIENT_SECRET=

# Opcionais
# AWS_PROFILE=colheita-terraform
# AWS_REGION=sa-east-1
